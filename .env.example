# Local development only. Do not reuse this password for deployment.
DATABASE_URL=postgresql://personal_context:local-development-only@127.0.0.1:55439/personal_context
API_HOST=127.0.0.1
API_PORT=3000

MAX_MEDIA_BYTES=20971520
BACKFILL_DAYS=30
CALENDAR_FUTURE_DAYS=90
# Model processing is disabled until each desired endpoint/model/version is set.
# EMBEDDING_ENDPOINT=https://your-gateway.example/embed
# EMBEDDING_MODEL=your-pinned-model
# EMBEDDING_VERSION=your-pinned-version
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_API_KEY=your-key
# CLASSIFIER_ENDPOINT=https://your-gateway.example/classify
# CLASSIFIER_MODEL=your-pinned-model
# CLASSIFIER_VERSION=your-pinned-version
# VISION_ENDPOINT=https://your-gateway.example/describe
# VISION_MODEL=your-pinned-model
# VISION_VERSION=your-pinned-version

APP_ORIGIN=http://127.0.0.1:5173
# Generate using: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# CREDENTIAL_ENCRYPTION_KEY=your-base64-32-byte-key

# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret
# SLACK_CLIENT_ID=your-client-id
# SLACK_CLIENT_SECRET=your-client-secret

# SLACK_APP_ID=A-your-registered-app-id

# Capital One production feasibility probe (existing owner-authorized Plaid Item).
# PLAID_ENV=production
# PLAID_CLIENT_ID=your-client-id
# PLAID_SECRET=your-production-secret
# PLAID_ACCESS_TOKEN=your-existing-owner-authorized-item-access-token

# Native local Ollama adapter (use npm run models:setup after pulling models).
# EMBEDDING_ADAPTER=ollama
# CLASSIFIER_ADAPTER=ollama
# VISION_ADAPTER=ollama
# Native Ollama endpoints use the loopback origin, e.g. http://127.0.0.1:11434.
# Ollama *_VERSION values must be full installed sha256 digests, not "latest".

# Slack local HTTPS callback (prepared by npm run slack:https:setup).
# SLACK_REDIRECT_URI=https://127.0.0.1:5443/api/connections/slack/callback
